{
  "name": "mongo-express",
  "version": "1.0.0",
  "main": "dist",
  "scripts": {
    "start": "ts-node -r tsconfig-paths/register src",
    "dev": "nodemon -q -w './**' --ext 'ts,json' --exec 'pnpm start'",
    "lint": "eslint . --max-warnings 0",
    "format": "pretty-quick --pattern '**/*.{ts,tsx,js,jsx,json,md}'"
  },
  "keywords": [
    "mongodb",
    "express"
  ],
  "author": "floatrx <ifloatrx@gmail.com>",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-sdk": "^2.7.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-fileupload": "^1.5.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.97",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/lib-storage": "^3.1131.0",
    "aws-sdk": "^2.1693.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4"
  }
}
