{
  "name": "mongo-express",
  "version": "1.0.0",
  "license": "ISC",
  "author": "floatrx",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "client": "cd client && pnpm dev",
    "server": "cd server && pnpm dev",
    "dev": "concurrently -n 'app,api' -c 'magenta,green.bold' 'pnpm server' 'pnpm client'",
    "lint": "pnpm --dir client lint && pnpm --dir server lint",
    "mongo": "docker compose up -d"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
